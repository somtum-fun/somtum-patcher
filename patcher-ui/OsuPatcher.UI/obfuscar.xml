<?xml version="1.0"?>
<!-- Obfuscar config, run by the build script after dotnet build. -->
<Obfuscator>
  <!-- InPath / OutPath / RefAsmPath come from build-bundle.sh via -var: CLI flags.
       Do NOT redefine them here with $(InPath) etc. — Obfuscar's variable
       expander treats "$(InPath)" as "look up InPath" and self-reference
       deadlocks it into a stack overflow at project-load time. -->
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="OptimizeMethods" value="false" />
  <Var name="AnalyzeXaml" value="true" />
  <AssemblySearchPath path="$(InPath)" />
  <AssemblySearchPath path="$(RefAsmPath)" />
  <Module file="$(InPath)/patcher-ui.exe">
    <!-- Rename ONLY types under OsuPatcher.UI.Attestation.*. Every other type keeps
         its original name so WPF, P/Invoke marshalling, and embedded-resource
         lookups (ExtractNativePayload) all keep working. The regex is applied by
         Obfuscar as "skip these"; everything NOT matching falls through to
         obfuscation only if HidePrivateApi lets it. Combined with KeepPublicApi
         (true) and our types being `internal static`, only our stuff gets touched. -->
    <SkipNamespace rx="^(?!OsuPatcher\.UI\.Attestation(\.|$)).*" />
  </Module>
</Obfuscator>
